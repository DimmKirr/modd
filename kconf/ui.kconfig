# @module -> AUDIO
# @module -> STORAGE
# @module -> MIDI
# @module --> WIFI "pages"
# @module --> DEBUG "pages"

menu "UI"

# kc2mm:hide
config INPUT
    bool "Panel input"
    default n

# kc2mm:label "Shell"
choice
    prompt "UI theme"
    default UI_FELUCCA if INPUT
    default UI_MODD

config UI_FELUCCA
    bool "Felucca"
    depends on INPUT
    select GEN_FELUCCA_UI
    help
      Port of Felucca's UI: SURF cards, Inter Tight font, anti-aliased
      icons, knob arcs, Felucca's pages and button map. Goal is a faithful
      port; modd-only modules (WiFi, weather, BLE) add pages under the
      existing views. Source: firmware/src/ui/themes/felucca/.

# Not yet selectable: no SLOOP theme exists (firmware/src/ui/themes/sloop/).
# Remove the 'depends on n' guard when it does.
config UI_SLOOP
    bool "SLOOP"
    depends on n

# Not yet selectable: no melodee shell implementation exists.
# Remove the 'depends on n' guard when themes/melodee/shell.c is ready.
config UI_MELODEE
    bool "Melodee"
    depends on n
    select GEN_MELODEE_UI

config UI_MODD
    bool "modd"
    select GEN_MELODEE_UI
    help
      modd's own UI on Melodee's renderer: Rubik type, Melodee's palettes plus
      the logo's MODD and MODD NIGHT. HOME, settings (HOME hold), weather (GLO
      hold). Ships its own button map. Does not require INPUT: works in
      emulator-only builds. Source: firmware/src/ui/themes/modd/.

endchoice

# kc2mm:label "Controls"
choice
    prompt "Control model"
    default CONTROLS_FELUCCA
    depends on !UI_MODD

config CONTROLS_FELUCCA
    bool "Felucca"
    help
      Felucca button layout: direct page navigation, SELECT steps pages,
      HOME hold opens ABOUT. GLO opens DEBUG when debug log is enabled.

config CONTROLS_MELODEE
    bool "Melodee"
    help
      Melodee button layout: SELECT adjusts BPM, GLO opens MIXER,
      SAVE opens SAVE page, HOME hold opens MENU.

config CONTROLS_SLOOP
    bool "SLOOP"
    help
      SLOOP button layout: SELECT adjusts BPM, GLO opens MIXER,
      0.7s hold threshold, HOME hold opens MENU.

endchoice

# kc2mm:hide
choice
    prompt "Splash screen"
    default SPLASH_LOGO

config SPLASH_LOGO
    bool "modd boot logo"
    help
      RLE-compressed logo from assets/logo-dark.png, centered on screen.
      Generated at build time by tools/logo_convert.py.

config SPLASH_NONE
    bool "No splash screen"
    help
      Skip the splash screen, go straight to the home page.

endchoice

config GEN_FELUCCA_UI
    bool
    help
      Hidden. Selected by UI_FELUCCA. Tells the build system to run
      Felucca font/icon/keycap/palette generators before compiling.

config GEN_MELODEE_UI
    bool
    help
      Hidden. Selected by UI_MODD and UI_MELODEE. Tells the build system to run
      Melodee's font and keycap generators and modd's palette list into
      build/gen/melodee/ before compiling.

endmenu
