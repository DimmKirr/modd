# @module -> AUDIO
# @module -> STORAGE
# @module -> MIDI
# @module --> WIFI "pages"
# @module --> DEBUG "pages"

menu "UI"

# kc2mm:hide
config INPUT
    bool "Panel input"
    default n

# kc2mm:label "Shell"
choice
    prompt "UI shell"
    default UI_SHELL_FELUCCA_UPSTREAM if INPUT
    default UI_SHELL_MODD

config UI_SHELL_FELUCCA_UPSTREAM
    bool "Felucca (upstream canvas)"
    depends on INPUT
    select GEN_FELUCCA_UI
    help
      Upstream Felucca UI: SURF cards, Inter Tight font, anti-aliased
      icons, knob arcs, Felucca's pages and button map rendered through
      Felucca's own canvas (gfx.c), not LVGL. Source:
      firmware/src/ui/shells/felucca/.

# Not yet selectable: no SLOOP shell exists (firmware/src/ui/shells/sloop/).
# Remove the 'depends on n' guard when it does.
config UI_SHELL_SLOOP
    bool "SLOOP"
    depends on n

# Not yet selectable: no melodee shell implementation exists.
# Remove the 'depends on n' guard when shells/melodee/shell.c is ready.
config UI_SHELL_MELODEE
    bool "Melodee"
    depends on n
    select GEN_MELODEE_UI

config UI_SHELL_MODD
    bool "modd"
    help
      The modd LVGL shell (defconfigs modd and modd_emu). Pages built from
      LVGL 9.6 widgets (firmware/vendor/lvgl, MIT), coloured by the active
      skin's palettes (10 per skin, CLAY by default for SKIN_MODD; the
      primary colour follows the selected track), drawn through two 240x24
      buffers. Pages: HOME, Settings (HOME hold), weather and DEMO (FX hold),
      the USB disk's files and info (SAVE hold, with UDISK), the log (GLO
      hold), page hints (GLO tap). Generates no font headers: the type is
      LVGL's built-in Montserrat. LVGL is compiled as a library next to the
      unity build (tools/build/build.py).
      Manual for the vendored version: docs/lvgl/. Source:
      firmware/src/ui/shells/modd/.

endchoice

# kc2mm:label "Skin"
choice
    prompt "UI skin"
    default UI_SKIN_MODD
    depends on UI_SHELL_MODD

config UI_SKIN_MODD
    bool "modd"
    help
      The default skin on the modd LVGL shell: modd palettes (10, CLAY by
      default) and modd controls. Source: firmware/src/ui/shells/modd/.

config UI_SKIN_FELUCCA
    bool "Felucca"
    help
      Felucca palettes (GREY default, 10 total) and Felucca controls on the
      modd LVGL shell. Dark by default; upstream Felucca pages (SONG, STEP,
      etc.) are added as they are ported. Source:
      firmware/src/ui/shells/felucca/lvgl_*.c, shared page code from
      firmware/src/ui/shells/modd/page_*.c.

endchoice

# kc2mm:label "Controls"
choice
    prompt "Control model"
    default CONTROLS_FELUCCA
    depends on !UI_SHELL_MODD

config CONTROLS_FELUCCA
    bool "Felucca"
    help
      Felucca button layout: direct page navigation, SELECT steps pages,
      HOME hold opens ABOUT. GLO opens DEBUG when debug log is enabled.

config CONTROLS_MELODEE
    bool "Melodee"
    help
      Melodee button layout: SELECT adjusts BPM, GLO opens MIXER,
      SAVE opens SAVE page, HOME hold opens MENU.

config CONTROLS_SLOOP
    bool "SLOOP"
    help
      SLOOP button layout: SELECT adjusts BPM, GLO opens MIXER,
      0.7s hold threshold, HOME hold opens MENU.

endchoice

# kc2mm:hide
choice
    prompt "Splash screen"
    default SPLASH_LOGO

config SPLASH_LOGO
    bool "modd boot logo"
    help
      RLE-compressed logo from assets/logo-dark.png, centered on screen.
      Generated at build time by tools/logo_convert.py.

config SPLASH_NONE
    bool "No splash screen"
    help
      Skip the splash screen, go straight to the home page.

endchoice

config PAGE_DEMO
    bool "Demo page"
    default y
    help
      The demo/test page in VIEW_CONN. Disable to remove it from
      the page cycle.

config GEN_FELUCCA_UI
    bool
    help
      Hidden. Selected by UI_SHELL_FELUCCA_UPSTREAM. Tells the build system to run
      Felucca font/icon/keycap/palette generators before compiling.

config GEN_MELODEE_UI
    bool
    help
      Hidden. Selected by UI_SHELL_MELODEE. Tells the build system to run
      Melodee's font and keycap generators and modd's palette list into
      build/gen/melodee/ before compiling.

endmenu
