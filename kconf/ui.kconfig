# @module -> AUDIO
# @module -> STORAGE
# @module -> MIDI
# @module --> WIFI "pages"
# @module --> DEBUG "pages"

menu "UI"

# kc2mm:hide
config INPUT
    bool "Panel input"
    default n

# kc2mm:label "Shell"
choice
    prompt "UI theme"
    default UI_THEME_FELUCCA if INPUT
    default UI_THEME_MODD

config UI_THEME_FELUCCA
    bool "Felucca"
    depends on INPUT
    select GEN_FELUCCA_UI
    help
      Port of Felucca's UI: SURF cards, Inter Tight font, anti-aliased
      icons, knob arcs, Felucca's pages and button map. Goal is a faithful
      port; modd-only modules (WiFi, weather, BLE) add pages under the
      existing views. Source: firmware/src/ui/themes/felucca/.

# Not yet selectable: no SLOOP theme exists (firmware/src/ui/themes/sloop/).
# Remove the 'depends on n' guard when it does.
config UI_THEME_SLOOP
    bool "SLOOP"
    depends on n

# Not yet selectable: no melodee shell implementation exists.
# Remove the 'depends on n' guard when themes/melodee/shell.c is ready.
config UI_THEME_MELODEE
    bool "Melodee"
    depends on n
    select GEN_MELODEE_UI

config UI_THEME_MODD
    bool "modd"
    help
      The main theme (defconfigs modd and modd_emu). Pages built from LVGL 9.6
      widgets (firmware/vendor/lvgl, MIT) on LVGL's default theme, coloured by the
      modd palettes (10, CLAY by default; the THEME colour follows the
      selected track), drawn through two 240x24 buffers. Pages and controls:
      HOME, Settings (HOME hold), weather and DEMO (FX hold), the USB disk's
      files and info (SAVE hold, with UDISK), the log (GLO hold), page hints
      (GLO tap). Generates no font headers: the type is LVGL's built-in
      Montserrat. LVGL is compiled as a library next to the unity build
      (tools/build/build.py).
      Manual for the vendored version: docs/lvgl/. Source:
      firmware/src/ui/themes/modd/.

endchoice

# kc2mm:label "Controls"
choice
    prompt "Control model"
    default CONTROLS_FELUCCA
    depends on !UI_THEME_MODD

config CONTROLS_FELUCCA
    bool "Felucca"
    help
      Felucca button layout: direct page navigation, SELECT steps pages,
      HOME hold opens ABOUT. GLO opens DEBUG when debug log is enabled.

config CONTROLS_MELODEE
    bool "Melodee"
    help
      Melodee button layout: SELECT adjusts BPM, GLO opens MIXER,
      SAVE opens SAVE page, HOME hold opens MENU.

config CONTROLS_SLOOP
    bool "SLOOP"
    help
      SLOOP button layout: SELECT adjusts BPM, GLO opens MIXER,
      0.7s hold threshold, HOME hold opens MENU.

endchoice

# kc2mm:hide
choice
    prompt "Splash screen"
    default SPLASH_LOGO

config SPLASH_LOGO
    bool "modd boot logo"
    help
      RLE-compressed logo from assets/logo-dark.png, centered on screen.
      Generated at build time by tools/logo_convert.py.

config SPLASH_NONE
    bool "No splash screen"
    help
      Skip the splash screen, go straight to the home page.

endchoice

config PAGE_DEMO
    bool "Demo page"
    default y
    help
      The demo/test page in VIEW_CONN. Disable to remove it from
      the page cycle.

config GEN_FELUCCA_UI
    bool
    help
      Hidden. Selected by UI_THEME_FELUCCA. Tells the build system to run
      Felucca font/icon/keycap/palette generators before compiling.

config GEN_MELODEE_UI
    bool
    help
      Hidden. Selected by UI_THEME_MELODEE. Tells the build system to run
      Melodee's font and keycap generators and modd's palette list into
      build/gen/melodee/ before compiling.

endmenu
