# @module WIFI --> BLE "mutex"

menu "WiFi"

# kc2mm:label "STA"
config WIFI
    bool "WiFi (802.11 b/g/n STA)"
    default n
    depends on !BLE
    help
      GPL-3.0 WiFi STA driver for the AC791N WL82 radio.
      Mutually exclusive with BLE in this version.

config WIFI_LWIP
    bool "IP networking over WiFi (lwIP)"
    depends on WIFI
    select LWIP
    default y

# kc2mm:label "WPA"
config WIFI_WPA
    bool "WPA2-PSK authentication"
    depends on WIFI
    default y

config WIFI_SSID
    string "Prebaked WiFi SSID"
    depends on WIFI
    default ""
    help
      SSID to auto-join after scan completes (requires WIFI_AUTOJOIN).
      Baked into the firmware at compile time. WIFI_SSID=... in the
      environment (or .env) overrides this at build time.

config WIFI_PASSWORD
    string "Prebaked WiFi password"
    depends on WIFI && WIFI_WPA
    default ""
    help
      WPA2-PSK password used by the WiFi config page when connecting
      to an encrypted AP. Baked into the firmware at compile time.
      Leave empty to disable auto-connect for encrypted networks.

config LLM
    bool "LLM inference (via local proxy)"
    depends on LWIP
    default n
    help
      Async LLM client that sends prompts to a local HTTP proxy, which
      forwards them as HTTPS POST to OpenRouter. The proxy host is set
      via CONFIG_LLM_PROXY_HOST; the API key is baked via .env.

config LLM_PROXY_HOST
    string "LLM proxy host (IP or hostname)"
    depends on LLM
    default ""
    help
      Host running the LLM proxy (e.g. "192.168.1.100"). The proxy
      listens on port 8484 and bridges plain HTTP GET from the FM-1
      to HTTPS POST on OpenRouter.

config LLM_MODEL
    string "OpenRouter model slug"
    depends on LLM
    default "deepseek/deepseek-v4.1-flash-1017"
    help
      Model identifier passed to the proxy for OpenRouter inference.

config OPENROUTER_API_KEY
    string "OpenRouter API key"
    depends on LLM
    default ""
    help
      API key for OpenRouter LLM inference, sent to the local proxy.
      Baked into the firmware at compile time. OPENROUTER_API_KEY=...
      in the environment (or .env) overrides this at build time.

config WIFI_AUTOJOIN
    bool "Auto-join after scan"
    depends on WIFI
    default n
    help
      After the first scan completes, attempt to join the AP matching
      CONFIG_WIFI_SSID. Requires WIFI_SSID to be set. Bring-up aid
      for testing association and the TX path end-to-end.

# kc2mm:label "MIDI"
config WIFI_MIDI
    bool "MIDI over WiFi (rtpMIDI/OSC)"
    depends on WIFI && WIFI_LWIP
    default n

# kc2mm:hide
config WIFI_MAC_OVERRIDE
    string "Debug: station MAC address override"
    depends on WIFI
    default ""
    help
      Use this MAC address (AA:BB:CC:DD:EE:FF) instead of the one read
      from the chip or generated at boot. Bring-up aid: the MAC hardware
      transmits with a transmitter address of its own, and the address the
      receive filter and ACK matcher are programmed with has to be the
      same one. WIFI_MAC_OVERRIDE=... in the environment overrides this
      at build time, like WIFI_PASSWORD. Leave empty for normal use.

# kc2mm:hide
config WIFI_DEBUG_AUTOSCAN
    bool "Debug: verbose WiFi diagnostics"
    depends on WIFI && DEBUG_LOG
    default n
    help
      Enable verbose WiFi logging: periodic auto-scans every 15 s, per-channel
      register dumps, AP BSSID/SSID discovery, TX/RX frame diagnostics, and
      auth/assoc details. Without this, only lifecycle messages are logged
      (init, scan start/done, connecting, connected, disconnect).
      Turn off for normal use.

# kc2mm:hide
config WIFI_DEBUG_WLCTL0_PROBE
    bool "Debug: release WL_CTL0 (0x14000) once after boot"
    depends on WIFI && DEBUG_DAP
    default n
    help
      Host-triggered WiFi probes over DAP (task debug:wl0): write WL_CTL0 = 0,
      log the running-indicator rows before and after, scan once; or retry
      the four SoC writes that refused on a held block, then scan. Since 12p
      the boot no longer asserts WL_CTL0, so the plain probe is just a scan
      with extra readbacks. Bring-up aid; turn off for normal use.

config WIFI_NONFREE
    bool "WiFi (vendor binary driver)"
    default n
    depends on !BLE && !WIFI
    help
      WiFi STA using JieLi's vendor binary libraries from the AC79 SDK.
      Links wl_wifi_sta_sfc.a, wpasupplicant.a, hsm.a, wl_rf_common.a
      with fm1-base's MPL-2.0/Apache-2.0 cooperative scheduler shim.
      For testing and comparison with the clean-room CONFIG_WIFI driver.
      Requires AC79_SDK to be set.

# kc2mm:hide
config WIFI_PROBES
    bool "WiFi hardware probes (cleanroom analyst)"
    # depends on !WIFI && !BLE  # temporarily removed for crash isolation
    depends on DEBUG_LOG && DEBUG_DAP
    default n
    help
      Minimal firmware for probing WiFi MAC/DMA registers on real hardware.
      Analyst-designed, results tagged [M:hw] for the SPECSHEET.
      Boots normally, inits WiFi clocks, reads register addresses, logs
      results over USB SysEx (DAP). No WiFi data path, no SDIO, no WPA.

config WIFI_T19_TEST
    bool "T19: Transmit decodability test"
    depends on WIFI
    default n
    help
      Diagnostic test for Phase D. After scan completes, sends 10 directed
      probe requests alternating CCK 1M and OFDM 6M to the strongest AP,
      logging TX_STA_CNT0/1 after each. Determines if the AP can decode
      our transmissions.

endmenu
