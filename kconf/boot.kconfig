# @module --> STORAGE
# @module --> USB

menu "Boot"

# kc2mm:label "Boot"
choice
    prompt "Boot/OTA"
    default BOOT_MELODEE

config BOOT_FELUCCA
    bool "Felucca (stock DFU)"

config BOOT_SLOOP
    bool "SLOOP (stock DFU)"

config BOOT_MELODEE
    bool "Melodee (M-UPGRADE SysEx OTA, safe-recovery)"

endchoice

# kc2mm:label "OTA"
config OTA
    bool "M-UPGRADE OTA (SysEx firmware update)"
    depends on BOOT_MELODEE && FLASH
    default y if BOOT_MELODEE && FLASH
    help
      Enable the M-UPGRADE SysEx update protocol. The running firmware
      reads the package from the host, stages the OTA updater in the
      OTA area, then reboots into it. Requires flash access (CONFIG_FLASH).
      Without this, firmware updates need manual UBOOT entry (hold OCT+/-
      for 5 seconds, or send the UBOOT soft key F0 22 24 35 7D F7).

config BOOT_LFN
    bool "Long filenames in the USB disk updater"
    default y
    help
      Enable FAT long filename (LFN) support in the USB disk OTA updater.
      Required to open files with extensions longer than 3 characters
      (e.g. .fwsc). Adds ~1 KB to the updater binary. Disable to save
      space if only 8.3 filenames (e.g. UPDATE.FWS) are used.

endmenu
