menu "Audio"

config AUDIO
    bool "Enable audio module"
    default n

# kc2mm:hide
config DUAL_CORE
    bool "Dual-core voice dispatch"
    default n
    depends on AUDIO

# kc2mm:label "Core"
choice
    prompt "Audio core upstream"
    depends on AUDIO
    default AUDIO_CORE_MELODEE

config AUDIO_CORE_FELUCCA
    bool "Felucca (8+6 voices)"

config AUDIO_CORE_SLOOP
    bool "SLOOP"

config AUDIO_CORE_MELODEE
    bool "Melodee (18 budget units, FPU)"

endchoice

# kc2mm:hide
config AUDIO_FELUCCA_STACK_INCLUDED
    bool "Felucca stack included from upstream (params, mod, voice, slicer, fx, audio)"
    depends on AUDIO_CORE_FELUCCA
    default n
    help
      Includes upstream Felucca's audio stack unchanged (core.h, params.c,
      mod.c, voice.c, slicer.c, fx.c, audio.c) through the adapter instead
      of modd's copies. The stack owns the audio interrupt, the mixer and
      the effects. Upstream's buffers are fixed-size: the hardware memory
      map does not hold them yet, so only the emulator defconfig sets this.

# kc2mm:hide
config FELUCCA_DLY_LEN
    int "Felucca delay line length (int16 samples, power of two)"
    depends on AUDIO_FELUCCA_STACK_INCLUDED
    range 4096 65536
    default 65536
    help
      DLY_LEN of upstream's fx.c, set through patches/felucca/0001. The
      delay line is DLY_LEN * 2 bytes of the pool (65536 = 128 KB, 1.49 s
      at 44.1 kHz). Must be a power of two: the code masks with LEN - 1.
      Halving it halves the longest delay time and frees half of the bytes
      (32768 = 64 KB, 0.74 s). The default is upstream's value.

# kc2mm:hide
config FELUCCA_CHO_LEN
    int "Felucca chorus line length (int16 samples, power of two)"
    depends on AUDIO_FELUCCA_STACK_INCLUDED
    range 512 8192
    default 2048
    help
      CHO_LEN of upstream's fx.c (patches/felucca/0001). 2048 = 4 KB.
      Power of two. A shorter line limits the chorus depth and rate.
      The default is upstream's value.

# kc2mm:hide
config FELUCCA_SL_LEN
    int "Felucca slicer recording length (22.05 kHz samples a track, power of two)"
    depends on AUDIO_FELUCCA_STACK_INCLUDED
    range 2048 16384
    default 4096
    help
      SL_LEN of upstream's slicer.c (patches/felucca/0001). The slicer
      keeps SL_LEN samples for each of the 4 tracks (4096 = 8 KB a
      track, 186 ms); the FX hold layer's loop buffer (perform.c) is the
      same memory. Power of two, at least 2048 (the OCT UP / DN delay
      uses 4096 stereo frames of it). The default is upstream's value.

# kc2mm:hide
config AUDIO_MELODEE_STACK_INCLUDED
    bool "Melodee stack included from upstream (params, mod, voice, mix, fx, seq)"
    depends on AUDIO_CORE_MELODEE
    default n
    help
      Includes upstream Melodee's audio stack unchanged (core.h, dsp.c,
      params.c, mod.c, voice.c, mix.c, fx.c, seq.c) through the adapter.
      The stack owns the voice allocator, the mixer and the effects.
      Melodee's types (NTRK=8, NVOICE=16, P_COUNT) replace modd's own.

# kc2mm:hide
config ARENA_MIN_LEFT
    int "Bytes the build must leave free for the audio arena"
    depends on AUDIO
    default 0 if AUDIO_FELUCCA_STACK_INCLUDED
    default 16384
    help
      Checked by tools/build/mem_report.py after the link for linker scripts
      without _resource_minimum (the emulator map). 0 for a build in which
      nothing borrows from the arena: the included Felucca stack uses fixed
      buffers only.

# kc2mm:hide
config AUDIO_24BIT
    bool "24-bit internal pipeline (Q23)"
    default n
    depends on AUDIO
    help
      Use Q23 (24-bit) precision for the internal audio pipeline instead
      of Q15 (16-bit). The DAC always receives 24-bit words; this option
      controls how many of those bits carry signal. With Q23, quiet tails
      fade smoothly into noise instead of quantizing into 16-bit steps.

if AUDIO_24BIT

config AUDIO_24BIT_HEADROOM
    int "Output headroom shift (bits)"
    default 1
    range 0 4
    help
      Right-shift applied after Q23 master volume, before the DMA buffer.
      1 = -6 dBFS ceiling (FMLab default, safest for polyphonic mix).
      0 = full 24-bit range, clips sooner with many voices.

# kc2mm:hide
config AUDIO_24BIT_DC_BLOCK
    bool "DC blocking filter"
    default n
    help
      One-pole DC blocker on the master output, matching FMLab's pipeline.
      Removes DC offset that can accumulate in Q23 from asymmetric
      waveforms and effects.

endif

endmenu
