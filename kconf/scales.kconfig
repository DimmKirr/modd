# kc2mm:ignore
menu "Scales"

choice
    prompt "Scale system"
    depends on AUDIO
    optional
    default SCALES_MELODEE

config SCALES_FELUCCA
    bool "Felucca"
    help
      Modd stub: 16 hard-coded scale masks. With CONFIG_CORE_FELUCCA
      the upstream scale tables arrive through the core and this
      choice is skipped.

config SCALES_MELODEE
    bool "Melodee"
    help
      70 scales incl. 54 microtonal, concert pitch 400-480Hz.

endchoice

endmenu
