menu "Debug"

config DEBUG
    bool "Debug mode"
    default n
    help
      Master switch for debug features. Enables diagnostic logging,
      the DEBUG UI page, and future debug instrumentation.

config DEBUG_LOG
    bool "Debug log ring buffer"
    default y if DEBUG
    depends on DEBUG
    help
      Enable a ring buffer for diagnostic messages.
      Subsystems write via modd_log(); the DEBUG page displays them.

config DEBUG_LOG_LINES
    int "Log ring buffer lines"
    depends on DEBUG_LOG
    range 64 1024
    default 248
    help
      Number of lines in the debug log ring buffer.
      Each line is 48 bytes; timestamps add 4 bytes per line.
      256 = 13KB, 512 = 26KB. Increase for USB hub debugging.

config DEBUG_DAP
    bool "USB debug protocol (DAP)"
    default y if DEBUG
    depends on DEBUG && USB
    help
      Enable the fm1-dock SysEx debug protocol (D_HELLO, D_LOG).
      Adds a NOINIT byte ring buffer that survives resets; the host
      reads logs incrementally via tools/fm1log.py or hbdeploy.py.

endmenu
