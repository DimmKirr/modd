# @module MIDI : UART Transport · Routing
# @module MIDI : Editor · Console
# @module MIDI -> AUDIO
# @module MIDI --> BLE "transport"
# @module USB : Device Driver · USB Audio
# @module USB : Host Controller

menu "MIDI"

config MIDI_UART
    bool "UART MIDI (TRS)"
    default n

config USB
    bool "USB (MIDI + Audio)"
    default n

choice
    prompt "MIDI routing"
    depends on MIDI_UART || USB
    default MIDI_MELODEE

config MIDI_FELUCCA
    bool "Felucca"
    help
      Stub: empty init functions only. MIDI control and clock arrive
      with CONFIG_CORE_FELUCCA (via upstream seq.c). Full MIDI routing
      (Learn, UART output) is not ported yet.

config MIDI_SLOOP
    bool "SLOOP"

config MIDI_MELODEE
    bool "Melodee"
    help
      Multi-channel routing, MPC pads, clock sources.

endchoice

config USB_AUDIO
    bool "USB Audio (class-compliant)"
    depends on USB
    default n
    help
      Stereo or 4-track capture. Melodee only.

config USB_AUDIO_HOST
    bool "USB Audio host (external DAC)"
    depends on USB_HOST
    default n
    help
      USB Audio Class 1 host driver: stream audio to an external USB
      DAC or sound card plugged into the FM-1's USB host port. The
      runtime Settings menu cycles among the modes enabled below.

config USB_AUDIO_HOST_44K_16
    bool "44.1 kHz 16-bit stereo"
    depends on USB_AUDIO_HOST
    default y
    help
      Native render rate, no sample rate conversion needed.

config USB_AUDIO_HOST_48K_24
    bool "48 kHz 24-bit stereo"
    depends on USB_AUDIO_HOST
    default y
    help
      Most USB DACs default to 48 kHz. Requires 44.1→48 kHz SRC.

config USB_AUDIO_HOST_48K_32
    bool "48 kHz 32-bit stereo"
    depends on USB_AUDIO_HOST
    default n

config USB_AUDIO_HOST_96K_24
    bool "96 kHz 24-bit stereo"
    depends on USB_AUDIO_HOST
    default n
    help
      576 bytes/frame, near the Full-Speed ISO limit (1023).

config EDITOR
    bool "SysEx web editor protocol"
    depends on USB
    default n
    help
      The F0 7D 46 4C editor protocol for the browser-based
      parameter editor and preset manager.

config CONSOLE
    bool "CDC serial console"
    depends on USB
    default n
    help
      Read-only diagnostics on the CDC-ACM virtual serial port.
      Mutually exclusive with USB Audio (shares the CDC endpoint).

endmenu
