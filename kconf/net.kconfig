# kc2mm:ignore
menu "Network"

config LWIP
    bool "lwIP TCP/IP stack"
    default n
    help
      lwIP 2.x (BSD) with IPv4, TCP, UDP, DHCP and DNS. Link-agnostic:
      WIFI_LWIP (the on-chip radio) and USB_NET (USB ethernet, iPhone
      tethering) each add a network interface on top of it.

config USB_NET
    bool "USB network link (ethernet adapter or iPhone tethering)"
    depends on USB_HOST
    select LWIP
    select USB_NET_ECM
    default n
    help
      Internet over USB: auto-detects what is plugged in. Supports
      CDC-ECM ethernet adapters (ASIX AX88179A etc.) and Apple iPhone
      tethering. Holds the OTG port in host mode while enabled.

config USB_NET_AUTO
    bool "Enable USB network from boot"
    depends on USB_NET
    default n
    help
      Starts with USB ETH on: the OTG port goes to host mode as
      soon as no computer is driving it, and whichever network link is
      plugged in comes up without a visit to the settings menu.

config USB_NET_ECM
    bool
    default n
    help
      Internal: CDC-ECM driver. Selected automatically by USB_NET.

endmenu
