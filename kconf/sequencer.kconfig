# kc2mm:ignore
menu "Sequencer"

choice
    prompt "Sequencer implementation"
    depends on AUDIO
    optional
    default SEQ_FELUCCA

config SEQ_FELUCCA
    bool "Felucca"
    help
      Reduced copy (modd-written): 64-step playback, live loop, per-track
      polymeter. Missing from upstream: chords, motion, song chain, MIDI
      clock. With CONFIG_CORE_FELUCCA the full upstream sequencer arrives
      through the core and this choice is skipped.

config SEQ_SLOOP
    bool "SLOOP"
    help
      Arranger, scenes.

endchoice

endmenu
