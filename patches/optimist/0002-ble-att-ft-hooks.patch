 BLE_API void ble_att_event(void)
 {
+    ATT_EVENT_HOOK();
     if (batt.sc_due && !batt.ind_wait && ble_ll_tx_room() >= 7u + BLE_ATT_RESERVE) {
         batt.buf[0] = 0x1D;                     /* Handle Value Indication: Service Changed, 0x0001..0xFFFF */
         ble_wr16(batt.buf + 1, H_SC);
