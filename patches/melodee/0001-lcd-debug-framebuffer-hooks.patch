Description: lcd_fill and lcd_blit call debug hooks when enabled
 Adds lcdfb_fill/lcdfb_blit calls under CONFIG_DEBUG_FRAMEBUFFER so the
 emulator's shadow framebuffer captures every draw, and mirror_fill/mirror_blit
 calls under CONFIG_MIRROR so the WebSocket mirror sees every draw.
 Hook only: without either config the compiled code is the same as upstream's.
Approved-by: Dmitry Kireev, 2026-11-24
Forwarded: no
Applies-to: keremimo/melodee v1.6.1 (165d177a425944f3d30b0b669255a6ed0050c3a5)
---
diff --git a/firmware/src/lcd.c b/firmware/src/lcd.c
index 1234567..abcdefg 100644
--- a/firmware/src/lcd.c
+++ b/firmware/src/lcd.c
@@ -76,6 +76,12 @@ static void lcd_fill(uint32_t x, uint32_t y, uint32_t w, uint32_t h, uint16_t c
         w = 240u - x;
     if (y + h > 240u)
         h = 240u - y;
+#ifdef CONFIG_DEBUG_FRAMEBUFFER
+    lcdfb_fill(x, y, w, h, c);
+#endif
+#ifdef CONFIG_MIRROR
+    if (mirror_on) mirror_fill(x, y, w, h, c);
+#endif
     lcd_sync();
     k = 240u / w * w;                       /* whole rows per transfer (narrow fills: one DMA) */
     for (i = 0; i < k; i++)
@@ -91,6 +97,12 @@ static void lcd_blit(uint32_t x, uint32_t y, uint32_t w, uint32_t h, const uint
 {
     if (!w || !h)
         return;
+#ifdef CONFIG_DEBUG_FRAMEBUFFER
+    lcdfb_blit(x, y, w, h, px);
+#endif
+#ifdef CONFIG_MIRROR
+    if (mirror_on) mirror_blit(x, y, w, h, px);
+#endif
     lcd_window(x, y, x + w - 1u, y + h - 1u);
     lcd_data(px, w * h * 2u);
 }
