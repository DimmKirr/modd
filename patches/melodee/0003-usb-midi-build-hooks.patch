         uint32_t i, ok = usb.sx_len == 6u;
         for (i = 0; ok && i < 6u; i++)
             ok = usb.sysex[i] == UBOOT_KEY[i];
@@ -668,6 +708,7 @@ static void sysex_byte(uint8_t b)
         sx_collect = 0;
 #endif
         usb.sx_on = 0;
+        USB_HOOK_SYSEX_DONE();
     }
 }
 
@@ -706,6 +747,7 @@ static void midi_in_event(uint32_t pkt)
     }
     if (cin >= 8u && cin <= 0xEu && (st >> 4) == cin && !((pkt >> 16) & 0x80u) &&
         ((cin == 0xCu || cin == 0xDu) || !(pkt & 0x80000000u))) {
