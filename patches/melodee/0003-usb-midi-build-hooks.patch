Description: usb.c gets build hooks for the HAL header, ep0buf, the USB strings and event/SysEx callbacks
 Adds #ifndef hooks, each defaulting to upstream's behaviour: USB_HAL_HEADER
 (default "../hal/fm1_usb.h", the #include goes through it), EP0BUF_DEFINED
 (skips the ep0buf definition), USB_STRINGS_DEFINED (skips STR1 / STR2), and
 empty callbacks USB_HOOK_CONFIG, USB_HOOK_SUSPEND, USB_HOOK_RESUME,
 USB_HOOK_RESET, USB_HOOK_MIDI_IN(pkt), USB_HOOK_SYSEX_BEGIN,
 USB_HOOK_SYSEX_BYTE(b), USB_HOOK_SYSEX_END and USB_HOOK_SYSEX_DONE. Hooks
 only: with none of the macros set the compiled code is the same as upstream's.
Approved-by: Dmitry Kireev, 2026-11-24
Forwarded: no
Applies-to: keremimo/melodee v1.6.1 (165d177a425944f3d30b0b669255a6ed0050c3a5)
---
diff --git a/firmware/src/usb.c b/firmware/src/usb.c
index fb9ec2f..9e58110 100644
--- a/firmware/src/usb.c
+++ b/firmware/src/usb.c
@@ -20,7 +20,38 @@
  * menu's USB AUDIO); usb_replug makes the host see the change. MELODEE_USB_HOST=1 adds usb_host.c: the menu's
  * USB HOST makes the port the host of a USB-MIDI controller (usb.up is 0 meanwhile). The update
  * loader leaves both off: MIDI only. */
-#include "../hal/fm1_usb.h"   /* registers; relative, so the loader and the host tests find it too */
+/* Hooks (modd): every macro below defaults to upstream's behaviour. A build may define it first. */
+#ifndef USB_HAL_HEADER
+#define USB_HAL_HEADER "../hal/fm1_usb.h"
+#endif
+#ifndef USB_HOOK_CONFIG
+#define USB_HOOK_CONFIG() ((void)0)                     /* SET_CONFIGURATION taken: usb.config is new */
+#endif
+#ifndef USB_HOOK_SUSPEND
+#define USB_HOOK_SUSPEND() ((void)0)                    /* bus suspend, before usb.suspended is set */
+#endif
+#ifndef USB_HOOK_RESUME
+#define USB_HOOK_RESUME() ((void)0)                     /* bus resume, before usb.suspended is cleared */
+#endif
+#ifndef USB_HOOK_RESET
+#define USB_HOOK_RESET() ((void)0)                      /* bus reset, before usb.resets is counted */
+#endif
+#ifndef USB_HOOK_MIDI_IN
+#define USB_HOOK_MIDI_IN(pkt) ((void)0)                 /* a channel message, before it is queued */
+#endif
+#ifndef USB_HOOK_SYSEX_BEGIN
+#define USB_HOOK_SYSEX_BEGIN() ((void)0)                /* F0 seen */
+#endif
+#ifndef USB_HOOK_SYSEX_BYTE
+#define USB_HOOK_SYSEX_BYTE(b) ((void)0)                /* every SysEx byte but F0 / F7 */
+#endif
+#ifndef USB_HOOK_SYSEX_END
+#define USB_HOOK_SYSEX_END() ((void)0)                  /* F7: usb.sysex[0..usb.sx_len) is the whole message */
+#endif
+#ifndef USB_HOOK_SYSEX_DONE
+#define USB_HOOK_SYSEX_DONE() ((void)0)                 /* after the message was handled */
+#endif
+#include USB_HAL_HEADER   /* registers; relative, so the loader and the host tests find it too */
 #ifndef MELODEE_CDC
 #define MELODEE_CDC 0
 #endif
@@ -39,7 +70,9 @@ enum { S_FADDR = 0, S_POWER = 1, S_INTRTX1 = 2, S_INTRTX2 = 3, S_INTRRX1 = 4, S_
        S_TXMAXP = 16, S_CSR0 = 17, S_TXCSR1 = 17, S_TXCSR2 = 18, S_RXMAXP = 19, S_RXCSR1 = 20, S_RXCSR2 = 21,
        S_COUNT0 = 22, S_RXCOUNT1 = 22, S_RXCOUNT2 = 23 };
 
+#ifndef EP0BUF_DEFINED                                  /* hook: the build owns ep0buf */
