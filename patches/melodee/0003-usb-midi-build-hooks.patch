 static uint8_t ua_dev_desc[sizeof DEV_DESC];            /* revision belongs to this same enumerated layout */
@@ -523,6 +558,7 @@ static void ep0_service(void)
         ua_hw_stop();
 #endif
         usb.config = s[2];
+        USB_HOOK_CONFIG();
         if (usb.config == 1u)
             ep1_config();
         else
@@ -633,6 +669,7 @@ static void sysex_byte(uint8_t b)
     if (b == 0xF0) {
         usb.sx_on = 1;
         usb.sx_len = 0;
+        USB_HOOK_SYSEX_BEGIN();
 #if MELODEE_OTA
         sx_collect = !sx_ready;
         sx_pos = 0;
@@ -648,9 +685,12 @@ static void sysex_byte(uint8_t b)
             sx_collect = 0;                             /* too long: not ours */
     }
 #endif
+    if (b != 0xF0 && b != 0xF7)
